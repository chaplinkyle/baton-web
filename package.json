{
  "name": "baton-web",
  "version": "0.1.0-rc.10",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "blueprint:check": "node scripts/check-blueprint.mjs",
    "test": "npm run blueprint:check && node --test tests/product.test.mjs && tsx --test tests/config.test.ts tests/koios-normalize.test.ts tests/plan-actions.test.ts tests/security-config.test.ts tests/wallet.test.ts tests/emulator.test.ts",
    "test:network": "tsx --test tests/discovery.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "preprod:wallet:init": "tsx scripts/preprod-wallets.ts init",
    "preprod:wallet:status": "tsx scripts/preprod-wallets.ts status",
    "preprod:automated": "tsx scripts/preprod-automated-test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lucid-evolution/lucid": "^0.6.2",
    "buffer": "6.0.3",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@lucid-evolution/provider": "^0.2.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.4",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3"
  }
}
